{
  "name": "waterqualitylens",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic address-to-Public-Water-System (PWS) lookup and NSF/ANSI-verified filtration matching engine. Cloudflare-native backend.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply waterlens --local",
    "db:migrate:remote": "wrangler d1 migrations apply waterlens --remote",
    "db:seed:local": "wrangler d1 execute waterlens --local --file=./seeds/demo.sql",
    "db:seed:remote": "wrangler d1 execute waterlens --remote --file=./seeds/demo.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.0"
  }
}
